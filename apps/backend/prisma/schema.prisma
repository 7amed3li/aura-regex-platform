// =======================================================
//  Aura Regex Platform - Final Schema v3.1 (Fixed)
// =======================================================

// 1. Configuration
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 2. Enums (for controlled value sets)
enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum RegexSafety {
  SAFE
  UNSAFE
  UNKNOWN
}

// 3. User Model (with Roles and Status)
model User {
  id        String        @id @default(cuid())
  email     String        @unique
  username  String?       @unique
  password  String
  role      UserRole      @default(USER)
  status    AccountStatus @default(ACTIVE)
  
  // ✅ الحقول الزمنية (تمت إزالة التكرار)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  
  // ✅ الحقل الجديد (Google Style Auditing)
  lastSignedIn DateTime?

  // Relationships
  folders        Folder[]
  rules          Rule[]
  generationLogs GenerationLog[]
  likes          RuleLike[]
  testCases      TestCase[] 
  comments       Comment[]
}

// 4. Folder Model (for organizing rules)
model Folder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationship to User
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relationship to Rules
  rules Rule[]

  @@unique([userId, name]) // A user cannot have two folders with the same name
  @@index([userId])
}

// 5. Rule Model (with Versioning, Sharing, and Stats)
model Rule {
  id          String   @id @default(cuid())
  name        String
  description String?
  naturalLang String
  regex       String
  isPublic    Boolean  @default(false) // For sharing
  timesUsed   Int      @default(0)     // For stats
  lastUsedAt  DateTime?                // For stats
   
  // Security fields
  safetyStatus    RegexSafety @default(UNKNOWN)
  safetyDetails   String?     // Details from the ReDoS analysis library

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
   
  // Relationships
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId    String?
  folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions    RuleVersion[]
  testCases   TestCase[]
  likes       RuleLike[]
  comments    Comment[]
   
  @@index([userId])
  @@index([folderId])
}

// 6. TestCase Model
model TestCase {
  id          String   @id @default(cuid())
  name        String   // e.g., "Should match valid email"
  testText    String   // The text to test the regex against
  shouldMatch Boolean  // True if it's a success case, False if it's a failure case
  createdAt   DateTime @default(now())

  // Relationship to Rule (Made optional)
  ruleId String?
  rule   Rule?    @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // Relationship to User (Added)
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([userId]) 
}


// 7. RuleLike Model
model RuleLike {
  createdAt DateTime @default(now())

  // Relationships (Composite Primary Key)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId String
  rule   Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([userId, ruleId]) // A user can like a rule only once
  @@index([ruleId])
}

// 8. RuleVersion Model
model RuleVersion {
  id          String   @id @default(cuid())
  naturalLang String
  regex       String
  createdAt   DateTime @default(now())

  // Relationship to the parent Rule
  ruleId String
  rule   Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

// 9. GenerationLog Model
model GenerationLog {
  id            String    @id @default(cuid())
  correlationId String?   @default(cuid())
  input         String
  output        String
  explanation   String?
  generationType String? // 'ACADEMIC' or 'DAILY'
  pythonExampleCode String?

  isSuccess     Boolean
  executionTime Int
  modelVersion  String?
  cost          Float?
  rating        Int?
  wasCorrect    Boolean?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt    

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([correlationId])
}


// 10. LoginAttempt Model (New for Brute Force Protection)
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  email     String
  success   Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([ip, email]) // Ensure unique combination of IP and email
  @@index([ip]) // Improve query performance for IP-based checks
}

// 11. Comment Model (New for Social Features)
model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId    String
  rule      Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([userId])
}