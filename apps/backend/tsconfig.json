{
  "compilerOptions": {
    // --- الإعدادات الأساسية (Essential Environment Settings) ---
    "target": "ES2022",                    // نسخة JavaScript الناتجة (مناسبة لآخر إصدارات Node.js)
    "module": "NodeNext",                  // يدعم ESM و CommonJS في نفس الوقت (لـ Node.js الحديث)
    "moduleResolution": "NodeNext",        // نفس أسلوب حل الوحدات مع ESM
    "lib": ["ES2022"],                     // مكتبات JavaScript القياسية المسموح بها
    "types": ["node"],                     // لأن المشروع بيشتغل على بيئة Node.js

    // --- التوافق والتشغيل المشترك (Interoperability) ---
    "allowJs": true,                       // يسمح بدمج ملفات .js في المشروع
    "esModuleInterop": true,               // يسمح باستيراد CommonJS على شكل ESM
    "forceConsistentCasingInFileNames": true, // يمنع أخطاء اختلاف الأحرف في أسماء الملفات

    // --- إعدادات الإخراج (Output Settings) ---
    "outDir": "./dist",                    // مكان إخراج الملفات بعد التحويل
    "rootDir": "./src",                    // مجلد الكود الأساسي
    "sourceMap": true,                     // يولّد خرائط للمساعدة في تصحيح الأخطاء (debug)
    "declaration": false,                  // ما نحتاج ملفات .d.ts في هذا الباكإند
    "declarationMap": false,               // إلغاء خرائط ملفات التعريف

    // --- فحص الأنواع (Type Checking) ---
    "strict": true,                        // يفعل جميع الفحوصات الصارمة
    "skipLibCheck": true,                  // يتجاهل فحص الأنواع في node_modules (لتسريع build)
    "noUncheckedIndexedAccess": true,      // يمنع الوصول لعناصر قد تكون undefined
    "noImplicitAny": true,                 // يمنع المتغيرات بدون نوع محدد
    "noEmitOnError": true,                 // يمنع الإخراج لو فيه أخطاء

    // --- اكتشاف الوحدات (Module Detection) ---
    "moduleDetection": "force",            // يجبر كل ملف أن يعتبر وحدة (module)

    // --- مسارات/خيارات مفيدة ---
    "resolveJsonModule": true,             // يسمح باستيراد JSON
    "allowSyntheticDefaultImports": true   // يسهل استيراد مكتبات بدون default export
    // ملاحظة: ما أضفنا "typeRoots" عشان ما يمنع تحميل تعريفاتك المخصّصة تلقائيًا
  },

  // ✅ نخلي الـ TypeScript يشمل ملفات التعريف المخصصة داخل src/types
  "include": ["src", "src/**/*", "src/types", "src/types/**/*"],
  "exclude": ["node_modules", "dist", ".prisma"]
}
